# =============================================================================
# Space Intel — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all values before running the app.
# Never commit .env.local or any file containing real secrets to version control.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
# Local dev: docker compose up -d to start Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spaceintel

# -----------------------------------------------------------------------------
# Auth (Clerk)
# Get keys from https://dashboard.clerk.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
# OpenAI — used for embeddings (text-embedding-3-small) and GPT-4o fallback
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace_me

# Anthropic — primary LLM for AI Research Chat (Claude)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace_me

# -----------------------------------------------------------------------------
# Inngest — Background Jobs
# https://app.inngest.com
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=replace_me
INNGEST_SIGNING_KEY=signkey-prod-replace_me

# -----------------------------------------------------------------------------
# Redis (optional in local dev — falls back to in-memory cache)
# Production: use Upstash Redis connection string
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
